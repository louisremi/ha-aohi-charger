__pycache__/
*.pyc
.DS_Store

# capture-server (tools/) — local runtime artefacts.
# Captures can contain credentials and WiFi SSIDs; never commit them.
node_modules/
tools/capture-server/logs/

# TLS material is generated per install and must never be committed:
# a shared private key would be identical for every user.
tools/**/tls/
tools/**/certs/
*.pem
